discord:                    # optional — global defaults for Discord posting
  # color: "#5865F2"       # default embed color for RSS embeds

feeds:                      # optional — global defaults for RSS feed fetching
  # max_age_days: 7        # skip feed entries older than this on every pull (default: 7)

# Heuristic processing blocks (ignore / skip / description / title / youtube) are all *layered*:
# set globally here, override per task, override again per feed — each more specific scope wins
# per leaf key. They are also valid inside each task and each feed (see the task example below).
ignore:                     # optional — omit a whole FIELD from the post
  # image: true            #   don't fetch / attach the og:image
  # description: true      #   drop the entry description/body entirely
skip:                       # optional — omit a whole ENTRY
  # url_contains: "/tag/"  #   skip entries whose URL contains this substring (str or list)
  # shorts: true           #   (YouTube) drop /shorts/ entries — self-gates to YouTube feeds
  # livestreams: true      #   (YouTube) drop livestreams / past-stream VODs — one watch-page fetch
  #                        #   per video, fail-open; self-gates to YouTube feeds
description:                # optional — regex transforms on the description (after HTML-stripping)
  # remove: "Points:.*"    #   re.sub each pattern out (str or list of regexes)
  # extract: "\\d+ de \\w+" #  keep only the match (group 1 if captured, else group 0)
  # replace: "Ad:\\s*"     #   re.sub(replace, with, description)
  # with: ""
title:                      # optional — same regex transforms, applied to the title
  # remove: "\\s*\\| Sponsored$"
youtube:                    # optional — YouTube-feeds-only scope: the same ignore/skip vocabulary,
                            # but applied only to YouTube channel feeds (a global ignore.description
                            # would otherwise clear every feed). shorts/livestreams self-gate anyway.
  # skip:
  #   shorts: true
  #   livestreams: true
  # ignore:
  #   description: true     #   one global lever: clear the description on all YouTube feeds

retention:                  # optional — disk retention for logs and eval traces
  # days: 30               # delete files under <state_dir>/{logs,evals}/ older than this (default: 30; 0 disables)

llm:                        # optional — LLM provider credentials (DeepSeek + Gemini only)
  api_key:                  # per-provider API keys (omit to read from $DEEPSEEK_API_KEY / $GEMINI_API_KEY env var)
    deepseek: !secret deepseek_api_key
    # gemini: !secret gemini_api_key

curate:                     # optional — global defaults for LLM curation/filter (RSS/digest tasks)
  model:                    # model used for filtering
    provider: deepseek      # one of: deepseek, gemini
    name: deepseek-v4-flash
    # reasoning: low        # optional — off|low|medium|high. Adapter ignores it on non-thinking models.
                            # Validator errors if set on a model the registry marks thinking:false.
                            # providers/llm/models.json lists known models + capabilities (unknown names = warning).
  # model:                  # array form: tries each in order, falls back on None response
  #   - provider: deepseek
  #     name: deepseek-v4-flash
  #     reasoning: low
  #   - provider: gemini
  #     name: gemini-2.5-flash
  language: "EN-US"         # language for filter memory briefings (default: EN-US; per-task 'language' overrides)

research:                   # optional — global defaults for agentic research tasks
  model:                    # model(s) driving the research loop. Array form = fallback chain;
    - provider: deepseek    # DeepSeek primary, Gemini fallback (e.g. for prompts DeepSeek refuses).
      name: deepseek-v4-flash
    - provider: gemini
      name: gemini-2.5-flash
  # instructions: "..."     # extra guidance appended to the research agent's system prompt

summarize:                  # optional — global defaults for LLM summarization
  model:
    provider: deepseek
    name: deepseek-v4-flash
  # model:
  #   - provider: deepseek
  #     name: deepseek-v4-flash
  #   - provider: gemini
  #     name: gemini-2.5-flash

tasks:
  # RSS task: fetches feeds and posts new entries as Discord embeds.
  - name: my-feeds
    # Minimum time between processing this task's feeds. Default: 1h.
    # Suffix decides the comparison kind:
    #   "30m"/"6h" — sliding-window duration since last run.
    #   "1d"/"1w"  — calendar-aligned: fires on the next sweep after the local
    #                date / ISO week has advanced. Use these for "once daily,
    #                as early as the cron tick allows".
    period: 1h
    # kind: digest           # posts a single digest message instead of individual embeds; affects LLM processing
    # curate:                # optional — LLM pre-post filter applied to all feeds in this task
    #   criteria: "Only keep items about AI and machine learning"
    #   model:               # optional; overrides curate.model
    #     provider: openai
    #     name: gpt-5.4-mini
    #     reasoning: low     # optional
    #   language: "PT-BR"    # optional; language for memory briefings; falls back to curate.language then EN-US
    #   instructions: "..."  # optional; extra instructions appended after the filter criteria
    #   explain: true        # optional — use filter_reason as item body (default: false)
    #   corroborate:         # optional — agentic loop that web-searches (via vasco) to verify
    #     enabled: true      #   claims (credibility) and check current state (dissonance) before judging
    #     max_steps: 3       #   max decision turns (default 3)
    #     max_searches: 8    #   total search budget across the run (default 8)
    #     max_results: 5     #   results per query (default 5)
    # ignore:                # optional — omit a FIELD (overrides global; feeds override this)
    #   image: true          #   skip image fetching for all feeds in this task
    #   description: true     #   drop the description for all feeds in this task
    # skip:                  # optional — omit an ENTRY
    #   url_contains: ["/shorts/", "/live/"]
    # description:           # optional — regex transforms on the description
    #   remove: ["Points:.*", "# Comments:.*"]
    # title:                # optional — regex transforms on the title
    #   extract: "\\d+ de \\w+"
    # youtube:                   # optional — YouTube-feeds-only scope (overrides global; feeds override this)
    #   skip: { shorts: true, livestreams: true }
    #   ignore: { description: true }
    # summarize: true        # optional — LLM-summarize each entry's description before filtering/posting
    #                        # default: true for digest tasks, false for RSS/embed tasks
    #                        # per-feed 'summarize' overrides this task-level default
    # summarize:             # long form: 'true' is implicit when using extra options
    #   language: "PT-BR"   # optional — override language for summaries (falls back to curate.language or EN-US)
    #   instructions: "Ignore marketing claims and focus on what was demonstrated/proved."  # optional
    pull:
      - feed:
          name: My Feed
          url: https://example.com/feed.xml
          # discord:
          #   color: "#FF0000"      # optional — overrides task/global discord.color for this feed
          # summarize: true         # optional — override task-level summarize for this feed (also accepts dict form)
          # curate:
          #   skip: true             # optional — bypass LLM curation for this feed (items always pass)
          # Feed-level ignore/skip/description/title override the task/global value per leaf key.
          # ignore:
          #   image: true
          #   description: false      # e.g. opt one channel out of a task/global youtube.ignore.description
          # skip:
          #   url_contains: "/shorts/"   # skip entries whose URL contains this substring (str or list)
          #   shorts: false              # e.g. opt one feed out of a task/global skip.shorts
          #   livestreams: false
          # description:                 # regex transforms (after HTML-stripping)
          #   remove: ["Subscribe", "Merch"]   # re.sub each out (str or list of regexes)
          #   extract: "\\d+ de \\w+"          # keep only the match (group 1 if captured, else group 0)
          #   replace: "Imagem do dia\\s*"     # re.sub(replace, with, description)
          #   with: ""
          # title:
          #   remove: "\\s*\\| Sponsored$"
      # - youtube:               # sugar over feed: builds the channel feed URL from channel_id
      #     name: My Channel      # optional — display name (else resolved from the feed title)
      #     channel_id: UCxxxxxxxxxxxxxxxxxxxxxx  # → feeds/videos.xml?channel_id=<id>
      #     # skip: { shorts: false }   # optional — per-source overrides (also: ignore / description /
      #     #                           # title / summarize / curate / discord, same as a feed)
    push:
      - discord:
          webhook: !secret discord_webhook_my_feeds  # or a literal URL string
          # color: "#5865F2"   # optional — overrides global discord.color for all feeds in this task
          # format: markdown   # optional — 'markdown' posts "## [Title](url)\nbody"; default 'embed'
          # wrap: false        # optional — disable line wrapping at 120 chars (default: true)
      # - file: "~/notes/my-feeds.md"  # optional — also append new items to a local file (.md or .jsonl)

  # Digest task: like RSS task but all passing entries from all feeds are collected
  # and posted as a single text message (splits into multiple if the 2000-char limit is hit).
  # No OG image fetching. URLs use [Title](<url>) to suppress Discord link previews.
  # - name: my-digest
  #   kind: digest
  #   period: 24h
  #   curate:
  #     criteria: "Only keep items about AI and machine learning"
  #   pull:
  #     - feed:
  #         name: My Feed
  #         url: https://example.com/feed.xml
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_my_digest

  # Real-estate task: structured listings via vasco's realestate adapter.
  # Detected by pull containing a realestate item. New listings are posted as Discord embeds.
  # vasco picks the parser by domain (vivareal, portal-a, portal-b),
  # so a realestate item just needs a `url` — which also keys its state bucket.
  # Multiple `realestate:` items are allowed (one per url); each gets its own state
  # bucket and last_run/failure isolation, but all post to the same push targets
  # as one batched stream.
  # - name: imoveis-vivareal
  #   period: 4h
  #   pull:
  #     - realestate:
  #         url: "https://www.vivareal.com.br/venda/sp/sao-paulo/..."  # search URL with filters
  #         name: "VivaReal"           # optional — display label (falls back to provider/url)
  #         max_items: 10              # optional — cap new items per run (avoids Discord spam on first run)
  #         min_area_per_room: 25      # optional, vivareal only — drop cramped layouts (area / quartos < N m²)
  #                                    # 25 = framework floor (internal notes)
  #         exclude_neighborhoods: ["North District", "Vila Índigo"]  # optional — block-list, case/accent-insensitive.
  #                                    # drops listings in these; only acts where the source exposes a neighborhood.
  #     - realestate:                     # additional source for the same task — different state bucket
  #         url: "https://portal-a.com.br/pt/pesq_imovel.php?pja=true&pcid=1&pcat=0&ptip=A"
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_imoveis
  #         # color: "#00b894"

  # Weather task: fetches daily forecast from Open-Meteo (no API key required) and posts
  # a wttr.in-style plain-text report to Discord. Detected by pull containing a weather item.
  # Must have at least one discord push target.
  # - name: weather
  #   period: 1d
  #   pull:
  #     - weather:
  #         latitude: -23.55
  #         longitude: -46.63
  #         location_name: "São Paulo, SP"
  #         timezone: "America/Sao_Paulo"
  #         uv_warn_threshold: 6   # optional — UV index considered unsafe (default: 6)
  #         forecast_days: 5       # optional — days including today (default: 5)
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_weather
  #         wrap: false        # recommended — weather lines are intentionally long

  # Weather (smart): signal-only variant. Today: apparent min/max, dangerous UV window,
  # rain window if significant. Upcoming days: only days with significant rain OR an
  # apparent-temp / humidity anomaly vs the location's climate normal for the current
  # calendar month (fetched once/month from Open-Meteo Archive, cached in state under
  # tasks.<name>.climate). On archive failure, falls back to forecast-window mean.
  # - name: weather-smart
  #   period: 1d
  #   pull:
  #     - weather:
  #         kind: smart            # smart-mode formatter; omit for verbose wttr.in-style output
  #         latitude: -23.55
  #         longitude: -46.63
  #         location_name: "São Paulo, SP"
  #         timezone: "America/Sao_Paulo"
  #         uv_warn_threshold: 6
  #         forecast_days: 7
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_weather

  # Finance task: pulls quotes from yfinance and posts to Discord. Detected by pull
  # containing a finance item. Two mutually-exclusive sub-modes per finance block:
  #
  # 1. report: periodic snapshot of a list of tickers — current price, weekly change,
  #    52w range with % distance from current. Renders an "## 📊 Report" H2 header
  #    followed by "### TICKER" + "$price | ±N.N% wk | 52w: ..." per ticker.
  # - name: finance-report
  #   period: 7d
  #   pull:
  #     - finance:
  #         report:
  #           stocks: [AAPL, MSFT, KO, PG, SPY, "EURUSD=X"]   # yfinance symbols (no aliasing)
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_finance
  #         wrap: false
  #
  # 2. monitor: intraday alerts. Fires on either:
  #    - `delta`: fractional move since the previous cron tick (0.05 = 5%)
  #    - `price: [low, high]`: when the price crosses out of (or back into) the band
  #    Silent on zero-alert ticks (no Discord post). State per ticker is stored under
  #    tasks.<name>.tickers and used as the delta/crossing baseline.
  #    Each rule is gated by exchange hours (DST-aware via stdlib zoneinfo) — closed-
  #    market tickers are skipped entirely. Exchange is inferred from the symbol
  #    suffix (.SA → b3, =X / .NYB → fx, X-USD → crypto, else us_equity); add
  #    `exchange: us_equity|b3|fx|crypto` per rule to override. Holidays are not
  #    modeled — a closed exchange on Thanksgiving will fetch and see no movement.
  # - name: finance-monitor
  #   period: 15m
  #   pull:
  #     - finance:
  #         monitor:
  #           - {ticker: "EURUSD=X", delta: 0.005}                     # inferred fx
  #           - {ticker: AAPL, delta: 0.05}                            # inferred us_equity
  #           - {ticker: NVDA, delta: 0.05, price: [800, 950]}
  #           - {ticker: MSFT, delta: 0.05, price: [400, 460]}
  #           - {ticker: "BTC-USD", delta: 0.02}                       # inferred crypto
  #           - {ticker: "ITSA4.SA", delta: 0.05}                      # inferred b3
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_finance
  #         wrap: false

  # Research task: an agentic loop that drives vasco's real search + fetch/extract (over vascod).
  # The LLM searches, reads promising pages, then synthesizes a cited answer — no provider
  # web_search. Detected by pull containing a research item. Posts the answer as plain text.
  - name: world-news
    period: 24h
    pull:
      - research:
          prompt: "Today's world news. Filter for signal > noise. Summarize with sources."
          # model:              # optional; overrides research.model (single spec or fallback list)
          #   provider: deepseek
          #   name: deepseek-v4-flash
          #   reasoning: low    # optional
          # instructions: "..."  # optional; extra guidance for the research agent
          # max_steps: 6        # optional — hard cap on agent turns (termination guarantee)
          # max_searches: 3     # optional — cap on total searches across the run
          # max_reads: 6        # optional — cap on total page reads across the run
          # max_results: 8      # optional — search results pulled per query
          # read_top: 5         # optional — passages extracted per page read
    push:
      - discord:
          webhook: !secret discord_webhook_world_news  # or a literal URL string
