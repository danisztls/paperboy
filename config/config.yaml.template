discord:                    # optional — global defaults for Discord posting
  # color: "#5865F2"       # default embed color for RSS embeds

feeds:                      # optional — global defaults for RSS feed fetching
  # max_age_days: 7        # skip feed entries older than this on every pull (default: 7)

retention:                  # optional — disk retention for logs and eval traces
  # days: 30               # delete files under <state_dir>/{logs,evals}/ older than this (default: 30; 0 disables)

llm:                        # optional — LLM provider credentials
  api_key:                  # per-provider API keys (omit to read from $DEEPSEEK_API_KEY / $OPENAI_API_KEY / $GEMINI_API_KEY env var)
    deepseek: !secret deepseek_api_key
    openai: !secret openai_api_key
    # gemini: !secret gemini_api_key

curate:                     # optional — global defaults for LLM curation/filter (RSS/digest tasks)
  model:                    # model used for filtering
    provider: deepseek      # one of: openai, gemini, anthropic, deepseek
    name: deepseek-v4-flash
    # reasoning: low        # optional — off|low|medium|high. Adapter ignores it on non-thinking models.
                            # Validator errors if set on a model the registry marks thinking:false.
                            # providers/llm/models.json lists known models + capabilities (unknown names = warning).
  # model:                  # array form: tries each in order, falls back on None response
  #   - provider: deepseek
  #     name: deepseek-v4-flash
  #     reasoning: low
  #   - provider: openai
  #     name: gpt-5.4-mini
  language: "EN-US"         # language for filter memory briefings (default: EN-US; per-task 'language' overrides)

search:                     # optional — global defaults for LLM search tasks
  model:                    # model used for web-search tasks; deepseek doesn't support web_search
    provider: openai
    name: gpt-5.4-nano
  # instructions: "..."     # additional instructions appended to the built-in system prompt for search tasks

summarize:                  # optional — global defaults for LLM summarization
  model:
    provider: deepseek
    name: deepseek-v4-flash
  # model:
  #   - provider: deepseek
  #     name: deepseek-v4-flash
  #   - provider: openai
  #     name: gpt-5.4-mini

tasks:
  # RSS task: fetches feeds and posts new entries as Discord embeds.
  - name: my-feeds
    # Minimum time between processing this task's feeds. Default: 1h.
    # Suffix decides the comparison kind:
    #   "30m"/"6h" — sliding-window duration since last run.
    #   "1d"/"1w"  — calendar-aligned: fires on the next sweep after the local
    #                date / ISO week has advanced. Use these for "once daily,
    #                as early as the cron tick allows".
    period: 1h
    # kind: digest           # posts a single digest message instead of individual embeds; affects LLM processing
    # curate:                # optional — LLM pre-post filter applied to all feeds in this task
    #   criteria: "Only keep items about AI and machine learning"
    #   model:               # optional; overrides curate.model
    #     provider: openai
    #     name: gpt-5.4-mini
    #     reasoning: low     # optional
    #   language: "PT-BR"    # optional; language for memory briefings; falls back to curate.language then EN-US
    #   instructions: "..."  # optional; extra instructions appended after the filter criteria
    #   web_search: true     # optional — let the LLM search for context / fact-check items (default: false)
    #   explain: true        # optional — use filter_reason as item body (default: false)
    # filter:                # optional — heuristic cleanup applied to all feeds in this task
    #   title:
    #     extract: "\\d+ de \\w+"
    #   description:
    #     - remove_phrases_with_urls: true
    # image:                 # optional — image settings for this task
    #   skip: true           # skip image fetching entirely (default: false)
    # summarize: true        # optional — LLM-summarize each entry's description before filtering/posting
    #                        # default: true for digest tasks, false for RSS/embed tasks
    #                        # per-feed 'summarize' overrides this task-level default
    # summarize:             # long form: 'true' is implicit when using extra options
    #   language: "PT-BR"   # optional — override language for summaries (falls back to curate.language or EN-US)
    #   instructions: "Ignore marketing claims and focus on what was demonstrated/proved."  # optional
    pull:
      - feed:
          name: My Feed
          url: https://example.com/feed.xml
          # discord:
          #   color: "#FF0000"      # optional — overrides task/global discord.color for this feed
          # summarize: true         # optional — override task-level summarize for this feed (also accepts dict form)
          # curate:
          #   skip: true             # optional — bypass LLM curation for this feed (items always pass)
          # filter:
          #   title:
          #     extract: "\\d+ de \\w+"           # extract match (group 1 if captured, else group 0)
          #   url:
          #     skip_containing: "/shorts/"       # skip entries whose URL contains this substring
          #     # skip_containing: ["/shorts/", "/live/"]  # also accepts a list
          #   description:                         # dict or list applied after HTML-stripping
          #     - clear: true                      # discard the description entirely
          #     - remove_phrases_with_urls: true   # drop phrases containing https:// URLs
          #     - remove_phrases_containing: "Subscribe"             # drop the clause containing this string
          #     - remove_phrases_containing: ["Subscribe", "Merch"] # also accepts an inline array
          #     - replace: "Imagem do dia\\s*"     # re.sub(replace, with, description)
          #       with: ""
    push:
      - discord:
          webhook: !secret discord_webhook_my_feeds  # or a literal URL string
          # color: "#5865F2"   # optional — overrides global discord.color for all feeds in this task
          # format: markdown   # optional — 'markdown' posts "### [Title](url)\nbody"; default 'embed'
          # wrap: false        # optional — disable line wrapping at 120 chars (default: true)
      # - file: "~/notes/my-feeds.md"  # optional — also append new items to a local markdown file

  # Digest task: like RSS task but all passing entries from all feeds are collected
  # and posted as a single text message (splits into multiple if the 2000-char limit is hit).
  # No OG image fetching. URLs use [Title](<url>) to suppress Discord link previews.
  # - name: my-digest
  #   kind: digest
  #   period: 24h
  #   curate:
  #     criteria: "Only keep items about AI and machine learning"
  #   pull:
  #     - feed:
  #         name: My Feed
  #         url: https://example.com/feed.xml
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_my_digest

  # Scraper task: browser-based extraction from websites that require JavaScript.
  # Detected by pull containing a scraper item. New listings are posted as Discord embeds.
  # After adding a new adapter, register it in scraper.py under _ADAPTERS.
  # - name: imoveis-vivareal
  #   period: 4h
  #   pull:
  #     - scraper:
  #         adapter: vivareal          # adapter name (must match _ADAPTERS key in scraper.py)
  #         url: "https://www.vivareal.com.br/venda/sp/sao-paulo/..."  # search URL with filters
  #         max_items: 10              # optional — cap new items per run (avoids Discord spam on first run)
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_imoveis
  #         # color: "#00b894"

  # Weather task: fetches daily forecast from Open-Meteo (no API key required) and posts
  # a wttr.in-style plain-text report to Discord. Detected by pull containing a weather item.
  # Must have at least one discord push target.
  # - name: weather
  #   period: 1d
  #   pull:
  #     - weather:
  #         latitude: -23.55
  #         longitude: -46.63
  #         location_name: "São Paulo, SP"
  #         timezone: "America/Sao_Paulo"
  #         uv_warn_threshold: 6   # optional — UV index considered unsafe (default: 6)
  #         forecast_days: 5       # optional — days including today (default: 5)
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_weather
  #         wrap: false        # recommended — weather lines are intentionally long

  # Weather (smart): signal-only variant. Today: apparent min/max, dangerous UV window,
  # rain window if significant. Upcoming days: only days with significant rain OR an
  # apparent-temp / humidity anomaly vs the location's climate normal for the current
  # calendar month (fetched once/month from Open-Meteo Archive, cached in state under
  # tasks.<name>.climate). On archive failure, falls back to forecast-window mean.
  # - name: weather-smart
  #   period: 1d
  #   pull:
  #     - weather:
  #         kind: smart            # smart-mode formatter; omit for verbose wttr.in-style output
  #         latitude: -23.55
  #         longitude: -46.63
  #         location_name: "São Paulo, SP"
  #         timezone: "America/Sao_Paulo"
  #         uv_warn_threshold: 6
  #         forecast_days: 7
  #   push:
  #     - discord:
  #         webhook: !secret discord_webhook_weather

  # Search task: calls an LLM with web search and posts the plain-text response to Discord.
  # Detected by pull containing a search item. Web search is always on.
  - name: world-news
    period: 24h
    pull:
      - search:
          prompt: "Today news. World. Filter for signal > noise."
          # model:              # optional; overrides search.model
          #   provider: openai
          #   name: gpt-5.4-mini
          #   reasoning: low    # optional
          # instructions: "..."  # optional; extra instructions appended to the built-in system prompt
          # web_search:         # optional; pass a dict to configure web_search_preview options
          #   allowed_domains:
          #     - reuters.com
          #   user_location:
          #     type: approximate
          #     country: US
    push:
      - discord:
          webhook: !secret discord_webhook_world_news  # or a literal URL string
