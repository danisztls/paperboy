llm:                        # optional — global defaults for all LLM tasks
  model: gpt-5.4-mini      # default model (per-task 'model' overrides this)
  # instructions: "..."      # system prompt

tasks:
  # RSS task: fetches feeds and posts new entries as Discord embeds.
  - name: my-feeds
    webhook: "https://discordapp.com/api/webhooks/<NUMBER>/<TOKEN>"
    # Minimum hours between processing this task's feeds. Default: 1.
    period: 1
    # filter:                    # optional — LLM pre-post filter applied to all feeds in this task
    #   prompt: "Only keep items about AI and machine learning"
    #   model: gpt-4o-mini       # optional; falls back to global llm.model, then default model
    # og_images: false           # optional — set to false to skip OG image fetching (default: true)
    feeds:
      - name:
        url:
        # regex_title: "\\d+ de \\w+"           # string → extract: title becomes the match (group 1 if captured, else group 0)
        # regex_description:                  # dict → substitute: re.sub(pattern, sub, description)
        #   pattern: "Imagem do dia\\s*"
        #   sub: ""

  # Digest task: like RSS task but all passing entries from all feeds are collected
  # and posted as a single embed (splits into multiple if the 4096-char limit is hit).
  # No OG image fetching. URLs use [Title](<url>) to suppress Discord link previews.
  # - name: my-digest
  #   type: digest
  #   webhook: "https://discordapp.com/api/webhooks/<NUMBER>/<TOKEN>"
  #   period: 24
  #   filter:
  #     prompt: "Only keep items about AI and machine learning"
  #   feeds:
  #     - name:
  #       url:

  # LLM task: calls OpenAI Responses API with web_search and posts the plain-text
  # response to Discord. Detected by presence of 'prompt' key.
  - name: world-news
    webhook: "https://discordapp.com/api/webhooks/<NUMBER>/<TOKEN>"
    period: 24
    prompt: "Today news. World. Filter for signal > noise."
    model: gpt-5.4-mini  # optional, default: gpt-5.4-mini
    # tools:             # optional — shallow-merged into the web_search_preview tool config
    #   allowed_domains:
    #     - reuters.com
    #   user_location:
    #     type: approximate
    #     country: US
