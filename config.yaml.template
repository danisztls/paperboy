discord:                    # optional — global defaults for Discord posting
  # color: "#5865F2"       # default embed color for RSS embeds
# og_image:                 # optional — global OG image settings
#   download: false         # download+optimize OG images as WebP attachments (default: false, uses URL directly)

llm:                        # optional — global defaults for all LLM tasks
  model: gpt-5.4-mini      # default model (per-task 'model' overrides this)
  # api_key: "sk-..."         # optional — overrides $OPENAI_API_KEY env var
  # instructions: "..."      # additional instructions appended to the built-in system prompt for LLM tasks
  # language: "EN-US"        # language for filter memory briefings (default: EN-US; per-filter 'language' overrides)

tasks:
  # RSS task: fetches feeds and posts new entries as Discord embeds.
  - name: my-feeds
    discord:
      webhook: "https://discordapp.com/api/webhooks/<NUMBER>/<TOKEN>"
      # color: "#5865F2"   # optional — overrides global discord.color for this task
    # Minimum time between processing this task's feeds. Default: 1h.
    # Requires a suffix: "30m", "6h", "1d".
    period: 1h
    # llm:                       # optional — LLM pre-post filter applied to all feeds in this task
    #   prompt: "Only keep items about AI and machine learning"
    #   model: gpt-4o-mini       # optional; falls back to global llm.model, then default model
    #   language: "PT-BR"        # optional; language for memory briefings; falls back to llm.language then EN-US
    #   instructions: "..."     # optional; extra instructions appended after the filter criteria in the built-in prompt
    #   web_search: true         # optional — let the LLM search for context / fact-check items (default: false)
    # filter:                    # optional — heuristic cleanup applied to all feeds in this task
    #   title:
    #     extract: "\\d+ de \\w+"
    #   description:
    #     - remove_phrases_with_urls: true
    # og_image:                  # optional — OG image settings for this task
    #   skip: true              # skip OG image fetching entirely (default: false)
    #   download: true          # download+optimize as WebP; overrides global og_image.download (default: false)
    feeds:
      - name:
        url:
        # discord:
        #   color: "#FF0000" # optional — overrides task discord.color for this feed
        # og_image:
        #   download: true        # optional — overrides task/global og_image.download for this feed
        # filter:
        #   title:
        #     extract: "\\d+ de \\w+"          # extract match (group 1 if captured, else group 0)
        #   url:
        #     skip_containing: "/shorts/"    # skip entries whose URL contains this substring
        #     # skip_containing: ["/shorts/", "/live/"]  # also accepts a list
        #   description:                       # dict or list applied after HTML-stripping
        #     - clear: true                    # discard the description entirely (no embed description field)
        #     - remove_phrases_with_urls: true # drop phrases containing https:// URLs
        #     - remove_phrases_containing: "Subscribe"           # drop the clause containing this string
        #     - remove_phrases_containing: ["Subscribe", "Merch"] # also accepts an inline array
        #     - replace: "Imagem do dia\\s*"   # re.sub(replace, with, description)
        #       with: ""

  # Digest task: like RSS task but all passing entries from all feeds are collected
  # and posted as a single embed (splits into multiple if the 4096-char limit is hit).
  # No OG image fetching. URLs use [Title](<url>) to suppress Discord link previews.
  # - name: my-digest
  #   type: digest
  #   discord:
  #     webhook: "https://discordapp.com/api/webhooks/<NUMBER>/<TOKEN>"
  #   period: 24h
  #   llm:
  #     prompt: "Only keep items about AI and machine learning"
  #   feeds:
  #     - name:
  #       url:

  # LLM task: calls OpenAI Responses API and posts the plain-text response to Discord.
  # Detected by absence of 'feeds' key and presence of 'llm' key. Requires llm.web_search.
  - name: world-news
    discord:
      webhook: "https://discordapp.com/api/webhooks/<NUMBER>/<TOKEN>"
    period: 24h
    llm:
      prompt: "Today news. World. Filter for signal > noise."
      model: gpt-5.4-mini  # optional, default: gpt-5.4-mini
      web_search: true      # required for LLM tasks; dict = options for web_search_preview
      # web_search:
      #   allowed_domains:
      #     - reuters.com
      #   user_location:
      #     type: approximate
      #     country: US
